@{
    ViewData["Title"] = "Mi primera vista";
    string autor = "Jose David";
    int edad = 23;
}

<html>
    <head>
        <title>@ViewBag.Title</title>
    </head>
    
    <body>
        <div>
            <h1>Modificando una vista</h1>
            <p>
                <strong>Yo soy: </strong> @autor<br />
                Mi edad es <input type="number" value="@edad" placeholder="23" />
            </p>
        </div>
        <div>
            <label>Pertenezo al grupo de PI llamado: </label>
            <input type="text" placeholder="AirDreams" />
        </div>
    </body>
</html>
